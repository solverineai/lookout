# Copy to .env and fill in. Keys stay on the server; .env is git-ignored.

# Meta Model API (dev.meta.ai → API keys)
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3

# Muse Glimmer (open weights) on any OpenAI-compatible host. Empty = triage runs on Spark and the ledger says so.
GLIMMER_API_KEY=
# GLIMMER_BASE_URL=https://api.fireworks.ai/inference/v1
# GLIMMER_MODEL=accounts/fireworks/models/muse-glimmer-30b

# Shopify dev store (Admin API access token). Empty = the built-in demo store.
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# WhatsApp Cloud API (test number). Empty = messages show only on the web phone.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SELLER_WHATSAPP=

# Daily model spend cap in USD; past it, model calls stop and the seller is told.
DAILY_COST_CAP=1.00
